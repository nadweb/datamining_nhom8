# Environment Variables Template
# Copy this file to .env and set your secrets
# DO NOT COMMIT .env TO VERSION CONTROL

# Aviationstack API Key (https://aviationstack.com)
AVIATIONSTACK_KEY=your_aviationstack_api_key_here

# Pipeline configurations
SCRAPE_INTERVAL_MINUTES=120
DEFAULT_DELAY_THRESHOLD=15

# Web application port & host
WEB_HOST=127.0.0.1
WEB_PORT=5000

